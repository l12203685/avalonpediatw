# ── Firebase Configuration ───────────────────────────────────
FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Firebase Admin Service Account JSON (base64 or raw JSON string)
FIREBASE_SERVICE_ACCOUNT_JSON={}

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# ── Auth / Security ──────────────────────────────────────────
# Custom JWT secret for Discord/Line OAuth tokens.
# REQUIRED — server will refuse to start if unset.
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
# or: openssl rand -hex 32
# Minimum 32 characters recommended.
JWT_SECRET=

# Admin API secret for /api/ai/selfplay endpoint
ADMIN_SECRET=change-me-in-production

# ── Discord OAuth ────────────────────────────────────────────
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token

# ── Line Bot ─────────────────────────────────────────────────
LINE_BOT_CHANNEL_ACCESS_TOKEN=your_line_bot_access_token
LINE_BOT_CHANNEL_SECRET=your_line_bot_channel_secret
# Feature flag — gate /command handling (/help /create /join /status /vote
# /rules /roles). Default disabled (2026-04-23): webhook still receives
# events but the bot does not reply. Set to true / 1 / yes / on to re-enable
# once features are production-ready.
LINE_BOT_COMMANDS_ENABLED=false

# Webhook URL 的唯一真實來源在 code，不在 LINE Console（2026-10-08，第 5 次壞掉後的根修）。
# 啟動後自動把算出來的 URL PUT 到 LINE Messaging API，並定期比對：
#   LINE_WEBHOOK_URL   明確指定完整 https URL（優先）；未設則用
#   PUBLIC_BASE_URL    或 Render 自動注入的 RENDER_EXTERNAL_URL，再接 /webhook/line
# 同一個 LINE channel 只能有一個 webhook URL → 只允許一個部署開 autoset，
# 其他副本設 LINE_WEBHOOK_AUTOSET=false（只回報漂移、不寫入）。
LINE_WEBHOOK_URL=
PUBLIC_BASE_URL=
LINE_WEBHOOK_AUTOSET=true
LINE_WEBHOOK_RECHECK_MIN=360
# 出站 LINE 訊息走 reply_token 排隊（免費）：等鏡像群裡有人講話時一次最多帶 5 則。
# 設 false 退回逐則 push（吃 LINE 官方帳號每月免費額度）。
LINE_REPLY_DRAIN=true
# 若另有 edward-listen-bot，填其 enqueue URL 即改走 listen-bot（優先於 reply drain）。
LISTEN_BOT_ENQUEUE_URL=

# ── Keep-alive（Render Free 防休眠）──────────────────────────────
# Render 上自動用 RENDER_EXTERNAL_URL/health，每 10 分鐘自我喚醒；本機不會啟動。
KEEP_ALIVE=true
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MIN=10

# ── Line OAuth (for web login) ────────────────────────────────
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret   # same secret reused for OAuth

# ── Line Notify OAuth ─────────────────────────────────────────
LINE_NOTIFY_CLIENT_ID=your_line_notify_client_id
LINE_NOTIFY_CLIENT_SECRET=your_line_notify_client_secret

# ── CORS / Server ────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Frontend URL (used for OAuth redirect URIs)
FRONTEND_URL=http://localhost:5173

# ── Lobby Chat Mirror (雙向同步) ──────────────────────────────
# 大廳聊天鏡射到 LINE 群 / Discord 頻道；unset = 停用
LOBBY_MIRROR_LINE_GROUP_ID=
LOBBY_MIRROR_DISCORD_CHANNEL_ID=
# bot 產生的加入連結 / Discord 邀請指回的玩家前端（正式機請填前端網域）
WEB_BASE_URL=http://localhost:5173

# ── GitHub 帳號庫 (email/密碼登入；GitHub-only 架構核心) ───────
# email+密碼帳號改存一個 PRIVATE GitHub repo（內含密碼雜湊，務必 private）。
# 三個都設好才啟用；未設則登入回 no_store（等同 Firestore 未配置）。
# Token：同 records，fine-grained、Repository access 只勾此帳號 repo、
#        Contents: Read and write。
GITHUB_ACCOUNTS_TOKEN=
GITHUB_ACCOUNTS_REPO=l12203685/avalonpediatw-accounts
GITHUB_ACCOUNTS_BRANCH=main

# ── GitHub 完賽歸檔 (一場一檔 append-only JSON) ────────────────
# 一場遊戲結束後，把該局 V2 record 寫到指定 repo 的
# games/{YYYY}/{MM}/{gameId}.json。三個都設好才會啟用；未設則靜默停用
# (best-effort，任何錯誤只記 log，絕不阻塞 game flow)。
# Token：GitHub → Settings → Developer settings → Fine-grained tokens，
#        Repository access 只勾該紀錄 repo、權限 Contents: Read and write。
GITHUB_RECORDS_TOKEN=
GITHUB_RECORDS_REPO=l12203685/avalon-game-records
GITHUB_RECORDS_BRANCH=main
