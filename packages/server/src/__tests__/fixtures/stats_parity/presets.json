      { "kind": "excludePlayers", "scope": "hideFromLists", "who": { "by": "metric", "metric": "positionTheory", "op": "lt", "value": 45 } }
    ] }
  },
  {
    "id": "offlineDropTopOverallFiltered",
    "filter": { "v": 1, "clauses": [
