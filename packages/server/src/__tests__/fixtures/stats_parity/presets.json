    ] }
  },
  {
    "id": "hideTopRoleTheory",
    "filter": { "v": 1, "clauses": [
      { "kind": "excludePlayers", "scope": "hideFromLists", "who": { "by": "metric", "metric": "roleTheory", "op": "gt", "pr": 90 } }
    ] }
  },
  {
    "id": "onlineHideLowPosition",
    "filter": { "v": 1, "clauses": [
