    ], "options": { "leaderboard": { "activeDays": 30, "mainGames": 60, "overallMinGames": 80, "roleTitleGames": 8, "roleTitleFallbackGames": 8, "loyalTitleGames": 30, "loyalTitleFallbackGames": 30 } } }
  }
